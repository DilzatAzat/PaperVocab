{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperVocab",
  "version": "0.1.0",
  "identifier": "com.papervocab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "PaperVocab", "width": 1120, "height": 760, "minWidth": 900, "minHeight": 640, "resizable": true, "visible": true },
      { "label": "capture", "title": "PaperVocab", "width": 380, "height": 330, "resizable": false, "decorations": false, "alwaysOnTop": true, "skipTaskbar": true, "focus": false, "visible": false }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } } }
}
